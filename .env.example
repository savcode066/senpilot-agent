# Copy to .env and fill in. Only the email settings are required for `run`.

# --- Mailbox the agent reads requests from and replies with -----------------
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it below.
AGENT_EMAIL_ADDRESS=regulatory.agent@gmail.com
AGENT_EMAIL_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
# Requests filed as spam are moved back to the inbox. Empty = don't check.
SPAM_FOLDER=[Gmail]/Spam
# 465 = implicit TLS, 587 = STARTTLS
SMTP_PORT=465
AGENT_NAME=UARB Regulatory Agent
POLL_INTERVAL_SECONDS=30
# Optional: only answer these senders (comma-separated addresses or @domains).
ALLOWED_SENDERS=

# --- Claude, for understanding free-form requests ----------------------------
# Optional. Without it the agent falls back to a rule-based parser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Behaviour ---------------------------------------------------------------
MAX_DOCUMENTS=10
# Keep the ZIP under this size so the reply fits within email limits.
MAX_ATTACHMENT_MB=18
HEADLESS=true
